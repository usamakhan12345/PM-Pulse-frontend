# Used by "next build" and "next start" (production). Local development keeps using .env.local.
NEXT_PUBLIC_API_URL=https://pulsepm.bonto.run/api
NEXT_PUBLIC_SOCKET_URL=https://pulsepm.bonto.run
# Set this to the public address of the website (the frontend), for the sitemap and share previews.
NEXT_PUBLIC_SITE_URL=https://pmpulsesoftware.vercel.app
